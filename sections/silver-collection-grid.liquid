{%- liquid
  assign cols = section.settings.columns_desktop | default: 3
  assign aspect = section.settings.aspect | default: 'portrait'
  assign per_page = section.settings.products_per_page | default: 12
  assign show_vendor = section.settings.show_vendor
-%}

<section class="silver-collection-grid" aria-label="{{ collection.title | escape }}">
  <div class="silver-collection-grid__inner">
    <header class="silver-collection-grid__header">
      <h1 class="silver-collection-grid__title">{{ collection.title }}</h1>
      {%- if collection.description != blank -%}
        <div class="silver-collection-grid__description body-text body-text--2">
          {{ collection.description }}
        </div>
      {%- endif -%}
    </header>

    {%- paginate collection.products by per_page -%}
      <div class="silver-collection-grid__toolbar">
        <p class="silver-collection-grid__count">
          {{ collection.products_count }} {{ collection.products_count | pluralize: 'product', 'products' }}
        </p>

        {%- if collection.sort_options.size > 0 -%}
          <form class="silver-collection-grid__sort" method="get">
            <label for="silver-sort-{{ section.id }}" class="silver-collection-grid__sort-label">
              Sort
            </label>
            <select
              name="sort_by"
              id="silver-sort-{{ section.id }}"
              class="silver-collection-grid__sort-select"
              onchange="this.form.submit()"
            >
              {%- for option in collection.sort_options -%}
                <option
                  value="{{ option.value }}"
                  {% if option.value == collection.sort_by or option.value == collection.default_sort_by %}selected="selected"{% endif %}
                >
                  {{ option.name }}
                </option>
              {%- endfor -%}
            </select>
          </form>
        {%- endif -%}
      </div>

      {%- if collection.products.size == 0 -%}
        <p class="silver-collection-grid__empty body-text body-text--1">
          No products found in this collection yet.
        </p>
      {%- else -%}
        <div class="silver-collection-grid__grid silver-collection-grid__grid--cols-{{ cols }}">
          {%- for product in collection.products -%}
            <div class="silver-collection-grid__item">
              {%- render 'silver-product-card', product: product, show_vendor: show_vendor, aspect: aspect, loading: forloop.index0, default: 'lazy' -%}
            </div>
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav class="silver-collection-grid__pagination" aria-label="Pagination">
            {%- if paginate.previous -%}
              <a href="{{ paginate.previous.url }}" class="silver-collection-grid__pagination-link silver-collection-grid__pagination-link--prev" rel="prev">&larr; Prev</a>
            {%- endif -%}

            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}
                <a href="{{ part.url }}" class="silver-collection-grid__pagination-link">{{ part.title }}</a>
              {%- else -%}
                <span class="silver-collection-grid__pagination-link silver-collection-grid__pagination-link--current" aria-current="page">{{ part.title }}</span>
              {%- endif -%}
            {%- endfor -%}

            {%- if paginate.next -%}
              <a href="{{ paginate.next.url }}" class="silver-collection-grid__pagination-link silver-collection-grid__pagination-link--next" rel="next">Next &rarr;</a>
            {%- endif -%}
          </nav>
        {%- endif -%}
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Silver collection grid",
  "tag": "section",
  "class": "silver-collection-grid-section",
  "settings": [
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns (desktop)",
      "min": 2, "max": 4, "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "aspect",
      "label": "Card aspect ratio",
      "default": "portrait",
      "options": [
        { "value": "portrait", "label": "Portrait (4:5)" },
        { "value": "square", "label": "Square (1:1)" }
      ]
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 6, "max": 48, "step": 6,
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    }
  ],
  "presets": [
    { "name": "Silver collection grid" }
  ]
}
{% endschema %}
