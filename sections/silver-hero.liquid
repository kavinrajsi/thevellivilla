{%- liquid
  assign align = section.settings.content_alignment | default: 'center'
  assign size = section.settings.size | default: 'medium'
  assign text_theme = section.settings.text_theme | default: 'light'
  assign overlay = section.settings.overlay_opacity | times: 0.01
-%}

<section
  class="silver-hero silver-hero--align-{{ align }} silver-hero--size-{{ size }} silver-hero--text-{{ text_theme }}"
  aria-label="{{ section.settings.heading | default: 'Hero' | escape }}"
>
  {%- if section.settings.image != blank -%}
    <div class="silver-hero__image">
      {{ section.settings.image | image_url: width: 2000 | image_tag:
         loading: 'eager',
         fetchpriority: 'high',
         widths: '640, 960, 1280, 1600, 2000',
         sizes: '100vw',
         alt: section.settings.image.alt | default: section.settings.heading
      }}
    </div>
    <div class="silver-hero__overlay" style="--silver-hero-overlay: {{ overlay }};"></div>
  {%- endif -%}

  <div class="silver-hero__inner">
    <div class="silver-hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="silver-hero__eyebrow subheading subheading--2">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="silver-hero__heading">{{ section.settings.heading }}</h1>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p class="silver-hero__subheading body-text body-text--1">{{ section.settings.subheading }}</p>
      {%- endif -%}

      {%- if section.settings.cta_label != blank and section.settings.cta_link != blank -%}
        <a href="{{ section.settings.cta_link }}" class="silver-hero__cta silver-button silver-button--primary">
          {{ section.settings.cta_label }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Silver hero",
  "tag": "section",
  "class": "silver-hero-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Spring collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Crafted for slow living" },
    { "type": "textarea", "id": "subheading", "label": "Sub-heading", "default": "Hand-finished pieces for the home you keep returning to." },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Shop the collection" },
    { "type": "url", "id": "cta_link", "label": "CTA link" },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "select",
      "id": "size",
      "label": "Size",
      "default": "medium",
      "options": [
        { "value": "small", "label": "Small (50vh)" },
        { "value": "medium", "label": "Medium (70vh)" },
        { "value": "large", "label": "Large (90vh)" }
      ]
    },
    {
      "type": "select",
      "id": "text_theme",
      "label": "Text theme",
      "default": "light",
      "options": [
        { "value": "light", "label": "Light (on dark image)" },
        { "value": "dark", "label": "Dark (on light image)" }
      ]
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Image overlay opacity",
      "min": 0, "max": 80, "step": 5, "unit": "%",
      "default": 25
    }
  ],
  "presets": [
    { "name": "Silver hero" }
  ]
}
{% endschema %}
