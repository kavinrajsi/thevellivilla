{%- liquid
  assign cols = section.settings.columns_desktop | default: 3
  assign aspect = section.settings.aspect | default: 'portrait'
  assign style = section.settings.card_style | default: 'stacked'
  assign show_count = section.settings.show_count
  assign sort = section.settings.sort | default: 'manual'
-%}

<section class="silver-collections-list" aria-label="All collections">
  <div class="silver-collections-list__inner">
    <header class="silver-collections-list__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="silver-collections-list__eyebrow subheading subheading--2">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 class="silver-collections-list__heading">{{ section.settings.heading }}</h1>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="silver-collections-list__subheading body-text body-text--1">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </header>

    {%- assign list = collections -%}
    {%- if sort == 'alphabetical' -%}
      {%- assign list = collections | sort: 'title' -%}
    {%- elsif sort == 'products_high' -%}
      {%- assign list = collections | sort: 'all_products_count' | reverse -%}
    {%- endif -%}

    {%- if list.size > 0 -%}
      <div class="silver-collections-list__grid silver-collections-list__grid--cols-{{ cols }}">
        {%- for collection in list -%}
          {%- if collection.handle == 'all' -%}{% continue %}{%- endif -%}
          <div class="silver-collections-list__item">
            {%- render 'silver-collection-card',
                collection: collection,
                style: style,
                aspect: aspect,
                show_count: show_count
            -%}
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="silver-collections-list__empty body-text body-text--1">
        No collections to show yet.
      </p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Silver collections list",
  "tag": "section",
  "class": "silver-collections-list-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Browse" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "All collections" },
    { "type": "textarea", "id": "subheading", "label": "Sub-heading" },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns (desktop)",
      "min": 2, "max": 4, "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Card style",
      "default": "stacked",
      "options": [
        { "value": "stacked", "label": "Title below image" },
        { "value": "overlay", "label": "Title overlays image" }
      ]
    },
    {
      "type": "select",
      "id": "aspect",
      "label": "Image aspect ratio",
      "default": "portrait",
      "options": [
        { "value": "portrait", "label": "Portrait (4:5)" },
        { "value": "square", "label": "Square (1:1)" },
        { "value": "landscape", "label": "Landscape (3:2)" }
      ]
    },
    {
      "type": "select",
      "id": "sort",
      "label": "Sort order",
      "default": "manual",
      "options": [
        { "value": "manual", "label": "Manual (admin order)" },
        { "value": "alphabetical", "label": "Alphabetical (A→Z)" },
        { "value": "products_high", "label": "Most products first" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "Show product count on cards",
      "default": true
    }
  ],
  "presets": [
    { "name": "Silver collections list" }
  ]
}
{% endschema %}
